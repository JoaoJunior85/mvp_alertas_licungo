# Copie para .env e substitua pelos dados do PostgreSQL/Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
PORT=3000
CORS_ORIGIN=http://localhost:8080

# Sem chave, o serviço usa modo simulado e imprime cada SMS no terminal.
SMS_API_KEY=
SMS_SENDER_ID=INGD

# URL usada ao executar localmente fora do Docker.
RISK_MODEL_API_URL=http://127.0.0.1:8000
# Segredo opcional partilhado pelo backend e API Python; em produção é gerado pelo Render.
MODEL_API_TOKEN=
